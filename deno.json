{
  "name": "@elite/shared-utils",
  "version": "0.1.0",
  "exports": "./src/mod.ts",
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "deno.json",
      "jsr.json",
      "src/**/*.ts"
    ]
  },
  "tasks": {
    "test": "deno test --allow-net --allow-env --coverage=cov_profile",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "publish:dry": "deno publish --dry-run --allow-dirty"
  },
  "lint": { "rules": { "tags": ["recommended"] } },
  "fmt": { "lineWidth": 100, "indentWidth": 2, "singleQuote": false }
}
